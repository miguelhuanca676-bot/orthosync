# Cabeceras de seguridad para las páginas servidas por Cloudflare Pages (las de /api las pone la API).
/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: no-referrer
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=()
  Cross-Origin-Opener-Policy: same-origin
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  Content-Security-Policy: default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; connect-src 'self'; font-src 'self'; object-src 'none'; base-uri 'none'; frame-ancestors 'none'; form-action 'self'

/sw.js
  Cache-Control: no-cache
  Service-Worker-Allowed: /

/app
  Cache-Control: no-cache

/assets/*
  Cache-Control: public, max-age=31536000, immutable
